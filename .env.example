# Copy this file to .env and fill in ONE of the Google options below.

# Option 1 (recommended): Serper.dev — live Google results, incl. answer boxes.
# Sign up at https://serper.dev and paste your API key here.
SERPER_API_KEY=

# Option 2: Google Programmable Search (Custom Search JSON API).
# Only works for existing keys — Google closed it to new sign-ups and shuts it down on 2027-01-01.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# With neither set, Jarvis falls back to DuckDuckGo Instant Answers + Wikipedia (no key needed).

# Optional: localise Google results (Serper only), e.g. us / gb / de and en / de.
SEARCH_COUNTRY=
SEARCH_LANGUAGE=

# Server
PORT=3000
# Keep 127.0.0.1: browsers only allow the microphone on localhost or HTTPS.
HOST=127.0.0.1
